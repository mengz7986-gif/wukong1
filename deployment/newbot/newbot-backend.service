[Unit]
Description=Independent new bot backend ONLY
After=network-online.target
Wants=network-online.target

[Service]
User=newbot
Group=newbot
WorkingDirectory=/opt/newbot/current/legacy_app
ExecStart=/opt/newbot/venv/bin/python /opt/newbot/current/deployment/newbot/start_backend.py
Restart=on-failure
RestartSec=5
UMask=0077
NoNewPrivileges=true
PrivateTmp=true
ProtectSystem=strict
ProtectHome=true
ReadWritePaths=/var/lib/newbot /var/log/newbot /var/cache/newbot /opt/newbot/current/legacy_app
MemoryMax=2G
TasksMax=128
StandardOutput=journal
StandardError=journal
SyslogIdentifier=newbot-backend

[Install]
WantedBy=multi-user.target
