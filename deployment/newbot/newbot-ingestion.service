[Unit]
Description=Newbot ingestion - explicit approval required
After=network-online.target newbot-backend.service
Requires=newbot-backend.service
ConditionPathExists=/etc/newbot/ingestion-approved
[Service]
User=newbot
Group=newbot
WorkingDirectory=/opt/newbot/current/legacy_app
ExecStart=/opt/newbot/venv/bin/python /opt/newbot/current/deployment/newbot/start_bot.py
Restart=no
UMask=0077
NoNewPrivileges=true
PrivateTmp=true
ProtectSystem=strict
ProtectHome=true
ReadWritePaths=/var/lib/newbot /var/log/newbot /var/cache/newbot /opt/newbot/current/legacy_app
MemoryMax=1G
TasksMax=128
StandardOutput=journal
StandardError=journal
[Install]
WantedBy=multi-user.target
